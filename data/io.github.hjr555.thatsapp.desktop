[Desktop Entry]
Type=Application
Name=ThatsApp
GenericName=WhatsApp Desktop Client
Comment=Native KDE Plasma desktop client for WhatsApp Web
Exec=thatsapp %u
Icon=io.github.hjr555.thatsapp
Terminal=false
Categories=Network;InstantMessaging;Chat;Qt;KDE;
Keywords=WhatsApp;Chat;Messaging;IM;
MimeType=x-scheme-handler/whatsapp;x-scheme-handler/whatsapp-smb;
StartupNotify=true
StartupWMClass=io.github.hjr555.thatsapp
SingleMainWindow=true
X-KDE-DBUS-ServiceName=io.github.hjr555.thatsapp
