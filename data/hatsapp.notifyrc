[Global]
IconName=io.github.hjr555.hatsapp
Name=HatsApp
Comment=WhatsApp Desktop Client
DesktopEntry=io.github.hjr555.hatsapp

[Event/newMessage]
Name=New Message
Comment=A new WhatsApp message has arrived
