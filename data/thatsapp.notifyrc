[Global]
IconName=io.github.hjr555.thatsapp
Name=ThatsApp
Comment=WhatsApp Desktop Client
DesktopEntry=io.github.hjr555.thatsapp

[Event/newMessage]
Name=New Message
Comment=A new WhatsApp message has arrived
